                "device_id": {
                    "name": "Instanz",
                    "description": "Zielinstanz auswählen"
                },
                "rule_type": {
                    "name": "Typ",
                    "description": "Typ der Regel"
                },
                "rule_payload": {
                    "name": "Regelinhalt",
                    "description": "Zu suchender Regelinhalt"
                },
