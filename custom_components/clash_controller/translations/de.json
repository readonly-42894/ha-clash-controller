        },
        "abort": {
            "already_configured": "Diese Instanz ist bereits eingerichtet.",
            "reauth_successful": "Zugangsdaten aktualisiert."
        }
    },
    "options": {
        "step": {
            "init": {
                "title": "Clash Controller – Optionen",
