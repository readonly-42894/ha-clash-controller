        "rules_failed": {
            "message": "Regeln konnten nicht abgerufen werden: {error}"
        },
        "api_call_failed": {
            "message": "API-Aufruf fehlgeschlagen: {error}"
        },
        "button_action_missing": {
            "message": "Für diese Schaltfläche ist keine Aktion definiert."
        },
        "button_action_failed": {
            "message": "{action} fehlgeschlagen: {error}"
        }
