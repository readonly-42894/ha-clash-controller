                "api_params": {
                    "name": "Parameter",
                    "description": "Abfrageparameter als gültiges JSON-Objekt"
                },
                "api_data": {
                    "name": "Daten",
                    "description": "Anfragedaten als gültiges JSON-Objekt"
                },
                "read_line": {
                    "name": "Zeile lesen",
                    "description": "Nummer der zu lesenden Zeile bei einer gestreamten Antwort"
